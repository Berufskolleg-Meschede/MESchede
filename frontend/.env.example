# Serverseitige Zieladresse des Auftragsproxys. Keine NEXT_PUBLIC-Variable nötig.
MES_BACKEND_URL=http://127.0.0.1:8000

# Serverseitige Zieladresse für /api/settings, /api/storage und /api/analytics.
# Fällt ohne Angabe auf http://localhost:8000 zurück; im Prod-Container auf
# http://backend:8000 setzen (siehe docker-compose.prod.yml).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

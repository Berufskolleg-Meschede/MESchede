# Copy to backend/.env and fill in real values before running docker-compose.prod.yml
# Must match the credentials in backend/.env.db
# Note: env_file values are NOT shell-interpolated by Docker Compose, so
# DATABASE_URL/ALEMBIC_DATABASE_URL must repeat the literal values below,
# not reference the other variables.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mes_db
POSTGRES_HOST=mes-db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:changeme@mes-db:5432/mes_db
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:changeme@mes-db:5432/mes_db

OPC_UA_URL=opc.tcp://localhost:4840/freeopcua/server
OPC_UA_USER=OPC_UA
OPC_UA_PASSWORD=12344321
RABBITMQ_URL=amqp://<user>:<password>@<host>:<port>/
RABBITMQ_STORAGE_INBOUND_QUEUE=
STORAGE_STALE_AFTER_SECONDS=3600

# Nur bestätigte Codes auswerten; ohne Zuordnung gilt Status 5 als erfolgreich.
OPC_UA_CONTRACT_VERIFIED=false
# Tatsächlich bestätigte finale Produktcodes als JSON; keine Testcodes übernehmen.
OPC_UA_PRODUCT_RESULTS={}
ORDER_POLL_INTERVAL_S=0.5
ORDER_REFRESH_INTERVAL_S=2
ORDER_STALE_AFTER_S=10
ORDER_START_TIMEOUT_S=30
ORDER_COMPLETION_TIMEOUT_S=600
ORDER_RESET_TIMEOUT_S=30
ORDER_REST_BUFFER_S=3
ORDER_PLANT_TIMEZONE=Europe/Berlin
PRODUCT_CATALOG_REFRESH_INTERVAL_S=30
PRODUCT_CATALOG_STALE_AFTER_S=300
